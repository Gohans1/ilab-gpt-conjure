{
  "name": "chatgpt-image-cli",
  "version": "1.0.0",
  "description": "Standalone CLI to generate and download images from ChatGPT Web",
  "type": "module",
  "bin": {
    "chatgpt-image": "./src/cli.ts"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "server": "bun run build && node dist/node-server.js",
    "generate": "bun run build && node dist/cli.js",
    "login": "bun run build && node dist/cli.js --login",
    "check:session": "bun run build && node dist/check-session.js",
    "test:connection": "bun run build && node dist/test-connection.js"
  },
  "dependencies": {
    "playwright-core": "^1.50.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
